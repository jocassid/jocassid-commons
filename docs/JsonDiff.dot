digraph JsonDiff{
  node [shape="rectangle"];
  label="JsonDiff";
  splines="ortho";
  subgraph cluster_json{
    label="json";
    subgraph cluster_JsonDiff{
      label="JsonDiff"
      run;
      render_container_diff;
      {
        rank="same";
				same_type[label="same type?" shape="diamond"];
				not_defined[label="not defined"];
			}
      type_list[label="type list?" shape="diamond"];
      get_list_format_params;
      get_dict_format_params;
      repr_length;
      render_item_same_container_type;
      get_item_data;
      get_keys_and_values_from_container;
      get_item_rows;
      get_repr

      run -> render_container_diff;
      render_container_diff -> same_type;

      same_type -> type_list[xlabel="1-yes"];
      same_type -> not_defined[xlabel="no"];
      same_type -> get_item_data[xlabel="2"];
      same_type -> render_item_same_container_type[xlabel="3"];

      type_list -> get_list_format_params[xlabel="yes"];
      type_list -> get_dict_format_params[xlabel="no"];

      get_item_data -> get_keys_and_values_from_container[xlabel="1"];
      get_item_data -> get_next_key_and_value[xlabel="2"];

      get_list_format_params-> repr_length;

      render_item_same_container_type -> get_item_rows[xlabel="1"];
      render_item_same_container_type -> get_repr[xlabel="2"];

    }
  }
}